# Bare-metal configuration (the installer writes /etc/veyra/veyra.env for you).
DATABASE_URL=postgres://veyra:change-me@localhost:5432/veyra
VEYRA_BIND=127.0.0.1:4000
VEYRA_PUBLIC_BASE_URL=https://veyra.example.com
VEYRA_DATA_DIR=./data

# production (default) | development
VEYRA_ENV=production
# Set to true ONLY behind a reverse proxy that overwrites X-Real-IP (the bundled nginx configs do).
VEYRA_TRUST_PROXY=false
# Only this address may become the first administrator.
VEYRA_ADMIN_EMAIL=

# At least 32 characters, unique per installation: openssl rand -base64 48
# The process refuses to start with a shorter or published placeholder value.
VEYRA_MASTER_ENCRYPTION_KEY=

STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_BYTES=5368709120
OTP_TTL_MINUTES=10
SESSION_TTL_HOURS=24
RUST_LOG=info

# SMTP is mandatory in production
SMTP_HOST=
SMTP_PORT=587
# tls = implicit TLS (465), starttls (587), none (development only). Empty = chosen from the port.
SMTP_TLS=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Veyra <no-reply@example.com>
