# Copy to .env for `docker compose up --build`.
# Generate secrets with:  openssl rand -hex 24    (database)   openssl rand -base64 48   (master secret)
POSTGRES_PASSWORD=change-me-use-alphanumeric-only
VEYRA_MASTER_ENCRYPTION_KEY=generate-with-openssl-rand-base64-48-at-least-32-chars

# production | development. In development, verification codes are printed to the API log when SMTP_HOST is empty.
VEYRA_ENV=development
VEYRA_PUBLIC_BASE_URL=http://localhost
VEYRA_HTTP_PORT=80
# Only this address can become the first administrator (strongly recommended).
VEYRA_ADMIN_EMAIL=

# Required when VEYRA_ENV=production
SMTP_HOST=
SMTP_PORT=587
# tls (port 465) | starttls (port 587) | none (development only); empty = chosen from the port
SMTP_TLS=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Veyra <no-reply@example.com>
